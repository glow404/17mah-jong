# 忽略依赖、缓存、构建产物、本地数据库和开发环境配置。
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# editors
/.idea/
/.vscode/*
!/.vscode/extensions.json
!/.vscode/settings.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
Thumbs.db
*.pem
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local environment and Cloudflare secrets
.env*
!.env.example
.dev.vars
.dev.vars.*

# local databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
*.tsbuildinfo
