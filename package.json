{
  "name": "17mah-jong",
  "version": "0.1.0",
  "description": "A full-stack two-player Japanese mahjong duel with custom hand building, online rooms, AI opponents, dora, and furiten.",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glow404/17mah-jong.git"
  },
  "homepage": "https://mah-jong-duel-17.vuhanhst943546.chatgpt.site",
  "bugs": {
    "url": "https://github.com/glow404/17mah-jong/issues"
  },
  "keywords": [
    "mahjong",
    "riichi-mahjong",
    "two-player-game",
    "multiplayer",
    "web-game",
    "react",
    "typescript",
    "cloudflare-workers",
    "cloudflare-d1"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run test:unit",
    "test:unit": "tsx --test tests/mahjong.test.ts tests/rules-matrix.test.ts",
    "test:integration": "tsx --test tests/integration/migrations.test.ts",
    "test:e2e": "tsx --test tests/e2e/smoke.test.ts tests/e2e/game-flow.test.ts tests/e2e/api-auth-rooms.test.ts",
    "test:e2e:playwright": "playwright test",
    "test:coverage": "c8 --all --include=lib/**/*.ts --reporter=text --reporter=json-summary --reports-dir=coverage/core --check-coverage --lines=90 --branches=90 --functions=90 tsx --test tests/mahjong.test.ts tests/rules-matrix.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate:ci": "node scripts/check-d1-migrations.mjs",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:coverage && npm run db:migrate:ci && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply mahjong-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply mahjong-db --remote"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "c8": "^12.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prettier": "^3.9.9",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
